@page "/personnages/{Id:guid}"
@using STS.Web.ViewModels
@using Sts.Domain.Character
@using Sts.Domain
@inject AuthService Auth
@inject NavigationManager Nav
@inject CharacterDetailViewModel VM
@inject IJSRuntime JS
@inject CharacterApiService Api

<PageTitle>@(VM.Character?.Name ?? "Personnage") — STS</PageTitle>

<div class="sts-page-header" style="margin-bottom:1rem;">
    <a href="/personnages" class="sts-back-link">← Personnages</a>
    <div style="display:flex;gap:0.5rem;margin-left:auto;">
        @if (VM.IsOwner)
        {
            <a href="/personnages/@Id/editer" class="sts-btn sts-btn-primary sts-btn-sm">✎ Éditer</a>
            <button class="sts-btn sts-btn-ghost sts-btn-sm" @onclick="ExportDiscord"
                    disabled="@_exporting">⬇ Discord</button>
            <button class="sts-btn sts-btn-ghost sts-btn-sm" @onclick="ExportPdf"
                    disabled="@_exporting">⬇ PDF</button>
            <button class="sts-btn sts-btn-ghost sts-btn-sm" @onclick="Delete">Supprimer</button>
        }
    </div>
</div>

@if (VM.IsLoading)
{
    <div class="sts-loading"><div class="sts-spinner-lg"></div></div>
}
else if (VM.Error is not null)
{
    <div class="sts-alert sts-alert-error">@VM.Error</div>
}
else if (VM.Character is { } c)
{
    var rank = Rank.Get(c.RankKey);

    <!-- En-tête -->
    <div class="sts-char-header" style="display:flex;gap:1.25rem;align-items:flex-start;">
        @if (VM.ImageUrl is not null)
        {
            <img src="@VM.ImageUrl" alt="Portrait de @c.Name"
                 style="width:112px;height:112px;object-fit:cover;border-radius:10px;
                        border:1px solid var(--border);flex-shrink:0;" />
        }
        <div>
            <h1 class="sts-page-title">@c.Name</h1>
            <div class="sts-card-meta">
                <span>@c.Race.Label()</span>
                <span class="sts-card-meta-dot"></span>
                <span>@rank.Label</span>
                <span class="sts-card-meta-dot"></span>
                <span>Palier @rank.Palier+</span>
                <span class="sts-card-meta-dot"></span>
                <span>@rank.Rerolls reroll(s)</span>
                @if (c.JobId is not null)
                {
                    <span class="sts-card-meta-dot"></span>
                    <span>@VM.JobName(c.JobId)</span>
                }
            </div>
        </div>

        <div class="sts-stat-grid" style="margin-top: 0.75rem;">
            <div class="sts-stat-box">
                <div class="sts-stat-label">Points de compétence</div>
                <div class="sts-stat-value">@c.SpentSkillPoints / @c.SkillPoints</div>
            </div>
            <div class="sts-stat-box">
                <div class="sts-stat-label">Réputation</div>
                <div class="sts-stat-value" style="font-size:16px;">
                    @Reputation.GetLabel(c.ReputationLevel)
                    <small style="font-size:11px; color:var(--text-muted);">
                        (@(c.ReputationLevel >= 0 ? "+" : "")@c.ReputationLevel)
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Histoire -->
    @if (!string.IsNullOrWhiteSpace(c.Histoire))
    {
        <div class="sts-card" style="margin-top: 1rem;">
            <div class="sts-card-desc" style="white-space: pre-wrap;">@c.Histoire</div>
        </div>
    }

    <!-- Certifications -->
    @if (c.Certifications.Count > 0)
    {
        <h2 class="sts-section-title">Certifications (@c.Certifications.Count)</h2>
        <div class="sts-cards">
            @foreach (var cert in c.Certifications)
            {
                <div class="sts-card">
                    <div class="sts-card-header">
                        <span style="color:var(--amber)">★</span>
                        <span class="sts-card-title">@cert.Name</span>
                    </div>
                    <div class="sts-card-meta">
                        @if (cert.LinkedOriginTraitId is not null)
                        {
                            <span>Trait d'origine : @VM.TraitName(cert.LinkedOriginTraitId)</span>
                        }
                        @if (cert.LinkedAbilityId is not null && cert.FreePoints > 0)
                        {
                            <span>@cert.FreePoints pt(s) gratuit(s) sur @VM.AbilityName(cert.LinkedAbilityId)</span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Trait d'origine -->
    @if (c.OriginTraitId is not null)
    {
        var originTrait = VM.GetTrait(c.OriginTraitId);
        var hasCert     = c.HasCertificationForOriginTrait(c.OriginTraitId);
        <h2 class="sts-section-title">Trait d'origine</h2>
        <div class="sts-card sts-card-accent-amber">
            <div class="sts-card-header">
                <span class="sts-card-title">@(originTrait?.Name ?? c.OriginTraitId)</span>
                @if (hasCert)
                {
                    <span class="sts-badge sts-badge-passive">Certifié — gratuit</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(originTrait?.Description))
            {
                <div class="sts-card-desc">@originTrait.Description</div>
            }
        </div>
    }

    <!-- Traits -->
    @if (c.EquippedTraitIds.Count > 0)
    {
        <h2 class="sts-section-title">Traits (@c.EquippedTraitIds.Count / @rank.Traits)</h2>
        <div class="sts-cards">
            @foreach (var tid in c.EquippedTraitIds)
            {
                var trait = VM.GetTrait(tid);
                <div class="sts-card">
                    <div class="sts-card-header">
                        <span class="sts-card-title">@(trait?.Name ?? tid)</span>
                        @if (trait?.Category is TraitCategory cat)
                        {
                            <span class="sts-badge sts-badge-weapon">@cat</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(trait?.Description))
                    {
                        <div class="sts-card-desc">@trait.Description</div>
                    }
                </div>
            }
        </div>
    }

    <!-- Compétences -->
    @if (c.EquippedAbilities.Count > 0)
    {
        <h2 class="sts-section-title">Compétences (@c.SpentSkillPoints / @c.SkillPoints pts)</h2>

        @foreach (var rang in new[] { 1, 2, 3 })
        {
            var groupe = c.EquippedAbilities
                .Where(eq => eq.Level == rang)
                .ToList();

            if (groupe.Count == 0) continue;

            <p class="sts-dim" style="font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin:0.75rem 0 0.25rem;">
                Rang @rang
            </p>
            <div class="sts-cards">
                @foreach (var eq in groupe)
                {
                    var ability   = VM.GetAbility(eq.AbilityId);
                    var fp        = c.GetFreePointsForAbility(eq.AbilityId);
                    var levelDesc = ability?.Levels
                        .Where(l => l.Level <= eq.Level)
                        .OrderBy(l => l.Level)
                        .ToList() ?? [];

                    <div class="sts-card">
                        <div class="sts-card-header">
                            <span class="sts-card-title">@(ability?.Name ?? eq.AbilityId)</span>
                            @if (fp > 0)
                            {
                                <span class="sts-badge sts-badge-passive">@fp pt(s) certif.</span>
                            }
                            @if (ability?.UsageLimit is UsageLimit ul && ul != UsageLimit.None)
                            {
                                <span class="sts-badge sts-badge-job">@VM.UsageLimitLabel(ul)</span>
                            }
                        </div>
                        @foreach (var ld in levelDesc)
                        {
                            @if (!string.IsNullOrWhiteSpace(ld.Description))
                            {
                                <div class="sts-card-desc" style="margin-top:4px;">
                                    @if (eq.Level > 1)
                                    {
                                        <span style="color:var(--teal); font-size:11px;">Lv@(ld.Level) — </span>
                                    }
                                    @ld.Description
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }
    }

    <!-- Inventaire -->
    @if (c.Inventory.Count > 0)
    {
        <h2 class="sts-section-title">Inventaire (@c.Inventory.Count objet(s))</h2>
        <div class="sts-cards">
            @foreach (var item in c.Inventory.OrderBy(i => i.SortIndex))
            {
                var isMain = c.MainHandItemId == item.Id;
                var isOff  = c.OffHandItemId  == item.Id;
                var unmastered = c.IsWeaponUnmastered(item);

                <div class="sts-card">
                    <div class="sts-card-header">
                        <span class="sts-card-title">@item.Name</span>
                        @if (item.Category == ItemCategory.Weapon)
                        {
                            <span class="sts-badge sts-badge-weapon">Arme</span>
                        }
                        @if (isMain) { <span class="sts-badge sts-badge-active">Main principale</span> }
                        @if (isOff)  { <span class="sts-badge sts-badge-active">Main secondaire</span> }
                        @if (unmastered) { <span class="sts-badge sts-badge-job">⚠ Palier 8</span> }
                    </div>
                    @if (item.LinkedAbilityId is not null)
                    {
                        <div class="sts-card-meta">
                            <span>Compétence : @VM.AbilityName(item.LinkedAbilityId)</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <div class="sts-card-desc">@item.Description</div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Auth.RequestLogin();
            Nav.NavigateTo("/");
            return;
        }

        VM.OnStateChanged = StateHasChanged;
        await VM.LoadAsync(Id);
    }

    private async Task Delete()
    {
        if (!await JS.InvokeAsync<bool>("confirm",
            $"Supprimer la fiche de « {VM.Character?.Name} » ? Cette action est irréversible."))
            return;

        var error = await VM.DeleteAsync();
        if (error is null) Nav.NavigateTo("/personnages");
    }

    private bool _exporting;

    private async Task ExportDiscord()
    {
        _exporting = true; StateHasChanged();
        try
        {
            var (data, _) = await Api.DownloadDiscordExportAsync(Id);
            if (data is not null)
                await JS.InvokeVoidAsync("downloadFile",
                    $"{VM.Character!.Name.Replace(" ", "_")}_discord.zip",
                    "application/zip", data);
        }
        finally { _exporting = false; StateHasChanged(); }
    }

    private async Task ExportPdf()
    {
        _exporting = true; StateHasChanged();
        try
        {
            var (data, _) = await Api.DownloadPdfAsync(Id);
            if (data is not null)
                await JS.InvokeVoidAsync("downloadFile",
                    $"{VM.Character!.Name.Replace(" ", "_")}.pdf",
                    "application/pdf", data);
        }
        finally { _exporting = false; StateHasChanged(); }
    }
}
