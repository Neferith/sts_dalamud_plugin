@page "/personnages/{Id:guid}"
@using STS.Web.ViewModels
@using Sts.Domain.Character
@using Sts.Domain
@inject AuthService Auth
@inject NavigationManager Nav
@inject CharacterDetailViewModel VM
@inject IJSRuntime JS
@inject CharacterApiService Api

<PageTitle>@(VM.Character?.Name ?? "Personnage") — STS</PageTitle>

<div class="sts-page-header" style="margin-bottom:1rem;">
    <a href="/personnages" class="sts-back-link">← Personnages</a>
    @if (VM.IsOwner)
    {
        <div class="sts-actions-desktop" style="margin-left:auto;">
            <a href="/personnages/@Id/editer" class="sts-btn sts-btn-primary sts-btn-sm">✎ Éditer</a>
            <button class="sts-btn sts-btn-ghost sts-btn-sm" @onclick="ExportDiscord" disabled="@_exporting">⬇ Discord</button>
            <button class="sts-btn sts-btn-ghost sts-btn-sm" @onclick="ExportPdf" disabled="@_exporting">⬇ PDF</button>
            <button class="sts-btn sts-btn-ghost sts-btn-sm sts-btn-danger" @onclick="Delete">Supprimer</button>
        </div>
        <div class="sts-actions-mobile" style="margin-left:auto;">
            <button class="sts-btn sts-btn-ghost sts-btn-sm" @onclick="() => _showActionsModal = true">⋯ Actions</button>
        </div>
    }
</div>

@if (VM.IsLoading)
{
    <div class="sts-loading"><div class="sts-spinner-lg"></div></div>
}
else if (VM.Error is not null)
{
    <div class="sts-alert sts-alert-error">@VM.Error</div>
}
else if (VM.Character is { } c)
{
    var rank        = Rank.Get(c.RankKey);
    var weaponCount = c.Inventory.Count(i => i.Category == ItemCategory.Weapon);
    var itemCount   = c.Inventory.Count(i => i.Category == ItemCategory.Item);
    var weapons     = c.Inventory.Where(i => i.Category == ItemCategory.Weapon).OrderBy(i => i.SortIndex).ToList();
    var items       = c.Inventory.Where(i => i.Category == ItemCategory.Item).OrderBy(i => i.SortIndex).ToList();

    <!-- En-tête personnage -->
    <div class="sts-char-header" style="display:flex;gap:1.25rem;align-items:flex-start;">
        @if (VM.ImageUrl is not null)
        {
            <img src="@VM.ImageUrl" alt="Portrait de @c.Name"
                 style="width:120px;height:120px;object-fit:cover;border-radius:10px;
                        border:1.5px solid var(--border-strong);
                        box-shadow:0 4px 16px rgba(0,0,0,0.45);
                        flex-shrink:0;" />
        }
        <div style="flex:1;min-width:0;">
            <h1 class="sts-page-title">@c.Name</h1>
            <div class="sts-card-meta sts-char-meta-center">
                <span>@c.Race.Label()</span>
                <span class="sts-card-meta-dot"></span>
                <span>@rank.Label</span>
                <span class="sts-card-meta-dot"></span>
                <span>Palier @rank.Palier+</span>
                <span class="sts-card-meta-dot"></span>
                <span>@rank.Rerolls reroll(s)</span>
                @if (c.JobId is not null)
                {
                    <span class="sts-card-meta-dot"></span>
                    <span>@VM.JobName(c.JobId)</span>
                }
            </div>
            <div class="sts-stat-grid sts-stats-row" style="margin-top:0.75rem;">
                <div class="sts-stat-box">
                    <div class="sts-stat-label">Points de compétence</div>
                    <div class="sts-stat-value">@c.SpentSkillPoints <span style="font-size:12px;color:var(--text-muted);">/ @c.SkillPoints pts</span></div>
                </div>
                <div class="sts-stat-box">
                    <div class="sts-stat-label">Réputation</div>
                    <div class="sts-stat-value" style="font-size:14px;">
                        @Reputation.GetLabel(c.ReputationLevel)
                        <small style="font-size:11px;color:var(--text-muted);">(@(c.ReputationLevel >= 0 ? "+" : "")@c.ReputationLevel)</small>
                    </div>
                </div>
                @if (c.Inventory.Count > 0)
                {
                    <div class="sts-stat-box sts-stat-box-link" @onclick="() => _activeTab = 1">
                        <div class="sts-stat-label">Inventaire</div>
                        <div style="font-size:12px;font-weight:500;color:var(--teal);margin-top:2px;">
                            @weaponCount arme(s) · @itemCount objet(s)
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Histoire -->
    @if (!string.IsNullOrWhiteSpace(c.Histoire))
    {
        <div class="sts-histoire @(_histoireExpanded ? "expanded" : "")"
             style="margin-top:1rem;"
             @onclick="() => _histoireExpanded = !_histoireExpanded">
            @c.Histoire
        </div>
    }

    <!-- Onglets -->
    <div class="sts-tab-bar">
        <button class="sts-tab @(_activeTab == 0 ? "active" : "")" @onclick="() => _activeTab = 0">Fiche</button>
        <button class="sts-tab @(_activeTab == 1 ? "active" : "")" @onclick="() => _activeTab = 1">
            Inventaire
            @if (c.Inventory.Count > 0)
            {
                <span class="sts-tab-count">(@c.Inventory.Count)</span>
            }
        </button>
    </div>

    <!-- ── Onglet Fiche ── -->
    @if (_activeTab == 0)
    {
        <div class="sts-detail-grid">

            <!-- Colonne gauche : certifications + compétences -->
            <div>
                @if (c.Certifications.Count > 0)
                {
                    <div class="sts-collapse-hdr" @onclick="() => _certOpen = !_certOpen">
                        <span class="sts-section-title" style="margin:0;">Certifications (@c.Certifications.Count)</span>
                        <svg class="sts-chevron @(_certOpen ? "" : "collapsed")" viewBox="0 0 16 16" fill="none">
                            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    @if (_certOpen)
                    {
                        <div class="sts-cert-grid" style="margin-top:0.4rem;margin-bottom:0.5rem;">
                            @foreach (var cert in c.Certifications)
                            {
                                <div class="sts-cert-item">
                                    <div class="sts-cert-name">★ @cert.Name</div>
                                    <div class="sts-cert-sub">
                                        @if (cert.LinkedOriginTraitId is not null)
                                        {
                                            <span>Trait : @VM.TraitName(cert.LinkedOriginTraitId)</span>
                                        }
                                        @if (cert.LinkedAbilityId is not null && cert.FreePoints > 0)
                                        {
                                            <span>@cert.FreePoints pt(s) — @VM.AbilityName(cert.LinkedAbilityId)</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }

                <div class="sts-collapse-hdr" style="margin-top:1.25rem;" @onclick="() => _compOpen = !_compOpen">
                    <span class="sts-section-title" style="margin:0;">Compétences (@c.SpentSkillPoints / @c.SkillPoints pts)</span>
                    <svg class="sts-chevron @(_compOpen ? "" : "collapsed")" viewBox="0 0 16 16" fill="none">
                        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                @if (_compOpen)
                {
                    @foreach (var rang in new[] { 1, 2, 3 })
                    {
                        var groupe   = c.EquippedAbilities.Where(eq => eq.Level == rang).ToList();
                        if (groupe.Count == 0) continue;
                        var rangOpen = rang switch { 2 => _r2Open, 3 => _r3Open, _ => _r1Open };

                        <div class="sts-rang-hdr" @onclick="() => ToggleRang(rang)">
                            <span class="sts-rang-label sts-rang-label-@rang">Rang @rang</span>
                            <svg class="sts-chevron sts-chevron-rang-@rang @(rangOpen ? "" : "collapsed")"
                                 viewBox="0 0 16 16" fill="none">
                                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        @if (rangOpen)
                        {
                            @foreach (var eq in groupe)
                            {
                                var ability     = VM.GetAbility(eq.AbilityId);
                                var fp          = c.GetFreePointsForAbility(eq.AbilityId);
                                var levelDesc   = ability?.Levels
                                    .Where(l => l.Level <= eq.Level)
                                    .OrderBy(l => l.Level)
                                    .ToList() ?? [];
                                var accentClass = rang switch { 2 => "sts-ability-card-r2", 3 => "sts-ability-card-r3", _ => "" };

                                <div class="sts-ability-card @accentClass">
                                    <div class="sts-card-header">
                                        <span class="sts-card-title">@(ability?.Name ?? eq.AbilityId)</span>
                                        @if (fp > 0)
                                        {
                                            <span class="sts-badge sts-badge-passive">@fp pt(s) certif.</span>
                                        }
                                        @if (ability?.UsageLimit is UsageLimit ul && ul != UsageLimit.None)
                                        {
                                            <span class="sts-badge sts-badge-job">@VM.UsageLimitLabel(ul)</span>
                                        }
                                    </div>
                                    @foreach (var ld in levelDesc)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(ld.Description))
                                        {
                                            <div class="sts-card-desc" style="margin-top:4px;">
                                                @if (eq.Level > 1)
                                                {
                                                    <span style="color:var(--teal);font-size:11px;">Lv@(ld.Level) — </span>
                                                }
                                                @ld.Description
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }
                    }
                }
            </div>

            <!-- Colonne droite : trait d'origine + traits -->
            <div>
                @if (c.OriginTraitId is not null)
                {
                    var originTrait = VM.GetTrait(c.OriginTraitId);
                    var hasCert     = c.HasCertificationForOriginTrait(c.OriginTraitId);
                    <h2 class="sts-section-title">Trait d'origine</h2>
                    <div class="sts-trait-item" style="border-left:2px solid var(--amber);border-radius:0 6px 6px 0;">
                        <div class="sts-trait-dot" style="background:var(--amber);"></div>
                        <div>
                            <div class="sts-trait-name">
                                @(originTrait?.Name ?? c.OriginTraitId)
                                @if (hasCert)
                                {
                                    <span class="sts-badge sts-badge-passive" style="margin-left:6px;">Certifié — gratuit</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(originTrait?.Description))
                            {
                                <div class="sts-trait-desc">@originTrait.Description</div>
                            }
                        </div>
                    </div>
                }

                @if (c.EquippedTraitIds.Count > 0)
                {
                    <div class="sts-collapse-hdr" style="margin-top:1.25rem;" @onclick="() => _traitsOpen = !_traitsOpen">
                        <span class="sts-section-title" style="margin:0;">Traits (@c.EquippedTraitIds.Count / @rank.Traits)</span>
                        <svg class="sts-chevron @(_traitsOpen ? "" : "collapsed")" viewBox="0 0 16 16" fill="none">
                            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    @if (_traitsOpen)
                    {
                        @foreach (var tid in c.EquippedTraitIds)
                        {
                            var trait = VM.GetTrait(tid);
                            <div class="sts-trait-item" style="margin-top:0.4rem;">
                                <div class="sts-trait-dot"></div>
                                <div>
                                    <div class="sts-trait-name">
                                        @(trait?.Name ?? tid)
                                        @if (trait?.Category is TraitCategory cat)
                                        {
                                            <span class="sts-badge sts-badge-weapon" style="margin-left:6px;">@cat</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(trait?.Description))
                                    {
                                        <div class="sts-trait-desc">@trait.Description</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }

    <!-- ── Onglet Inventaire ── -->
    @if (_activeTab == 1)
    {
        <div class="sts-inv-stats">
            <div class="sts-stat-box">
                <div class="sts-stat-label">Armes</div>
                <div class="sts-stat-value" style="font-size:18px;">@weaponCount</div>
            </div>
            <div class="sts-stat-box">
                <div class="sts-stat-label">Objets divers</div>
                <div class="sts-stat-value" style="font-size:18px;">@itemCount</div>
            </div>
        </div>

        @if (weapons.Count > 0)
        {
            <h2 class="sts-section-title" style="margin-top:1rem;">Armes</h2>
            <div class="sts-inv-grid">
                @foreach (var item in weapons)
                {
                    var isMain     = c.MainHandItemId == item.Id;
                    var isOff      = c.OffHandItemId  == item.Id;
                    var unmastered = c.IsWeaponUnmastered(item);

                    <div class="sts-inv-card @(isMain || isOff ? "sts-inv-card-equipped" : "")"
                         @onclick="() => OpenItemModal(item, isMain, isOff, unmastered)">
                        <span class="sts-inv-icon">⚔</span>
                        <div class="sts-inv-name">@item.Name</div>
                        @if (isMain)
                        {
                            <svg class="sts-inv-hand sts-inv-hand-main" viewBox="0 0 14 14" fill="none">
                                <path d="M4 2.5C4 1.67 4.67 1 5.5 1S7 1.67 7 2.5V7M7 2.5C7 1.67 7.67 1 8.5 1S10 1.67 10 2.5V7M10 3.5C10 2.67 10.67 2 11.5 2S13 2.67 13 3.5V9C13 11.21 11.21 13 9 13H6C4.14 13 2.56 11.82 2.07 10.17L1.12 7.03A1.5 1.5 0 012.56 5.14L3.5 5.5V2.5"
                                      stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                        else if (isOff)
                        {
                            <svg class="sts-inv-hand sts-inv-hand-off" viewBox="0 0 14 14" fill="none">
                                <path d="M4 2.5C4 1.67 4.67 1 5.5 1S7 1.67 7 2.5V7M7 2.5C7 1.67 7.67 1 8.5 1S10 1.67 10 2.5V7M10 3.5C10 2.67 10.67 2 11.5 2S13 2.67 13 3.5V9C13 11.21 11.21 13 9 13H6C4.14 13 2.56 11.82 2.07 10.17L1.12 7.03A1.5 1.5 0 012.56 5.14L3.5 5.5V2.5"
                                      stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                        else
                        {
                            <span class="sts-inv-hand-placeholder"></span>
                        }
                    </div>
                }
            </div>
        }

        @if (items.Count > 0)
        {
            <h2 class="sts-section-title" style="margin-top:1rem;">Objets divers</h2>
            <div class="sts-inv-grid">
                @foreach (var item in items)
                {
                    <div class="sts-inv-card" @onclick="() => OpenItemModal(item, false, false, false)">
                        <span class="sts-inv-icon">◈</span>
                        <div class="sts-inv-name">@item.Name</div>
                        <span class="sts-inv-hand-placeholder"></span>
                    </div>
                }
            </div>
        }
    }
}

<!-- Modale actions mobile -->
@if (_showActionsModal)
{
    <div class="sts-modal-backdrop" @onclick="() => _showActionsModal = false"></div>
    <div class="sts-modal">
        <div class="sts-modal-header">
            <h2 class="sts-modal-title">Actions</h2>
            <button class="sts-modal-close" @onclick="() => _showActionsModal = false">✕</button>
        </div>
        <div class="sts-modal-body">
            <div class="sts-mobile-actions">
                <a href="/personnages/@Id/editer" class="sts-mobile-btn sts-mobile-btn-primary">✎ Éditer</a>
                <button class="sts-mobile-btn sts-mobile-btn-ghost"
                        @onclick="() => { _showActionsModal = false; _ = ExportDiscord(); }"
                        disabled="@_exporting">⬇ Export Discord</button>
                <button class="sts-mobile-btn sts-mobile-btn-ghost"
                        @onclick="() => { _showActionsModal = false; _ = ExportPdf(); }"
                        disabled="@_exporting">⬇ Export PDF</button>
                <button class="sts-mobile-btn sts-mobile-btn-danger"
                        @onclick="() => { _showActionsModal = false; _ = Delete(); }">Supprimer</button>
            </div>
        </div>
    </div>
}

<!-- Modale détail item -->
@if (_showItemModal && _selectedItem is not null)
{
    <div class="sts-modal-backdrop" @onclick="() => _showItemModal = false"></div>
    <div class="sts-modal">
        <div class="sts-modal-header">
            <h2 class="sts-modal-title">
                @_selectedItem.Name
                <span class="sts-badge @(_selectedItem.Category == ItemCategory.Weapon ? "sts-badge-weapon" : "sts-badge-passive")"
                      style="margin-left:8px;font-size:10px;">
                    @(_selectedItem.Category == ItemCategory.Weapon ? "Arme" : "Objet")
                </span>
            </h2>
            <button class="sts-modal-close" @onclick="() => _showItemModal = false">✕</button>
        </div>
        <div class="sts-modal-body" style="display:flex;flex-direction:column;gap:6px;">
            @if (_itemIsMain)     { <span class="sts-badge sts-badge-active" style="width:fit-content;">Main principale</span> }
            @if (_itemIsOff)      { <span class="sts-badge sts-badge-active" style="width:fit-content;">Main secondaire</span> }
            @if (_itemUnmastered) { <span class="sts-badge sts-badge-job" style="width:fit-content;">⚠ Palier 8 requis</span> }
            @if (_selectedItem.LinkedAbilityId is not null)
            {
                <div class="sts-card-meta">
                    <span>Compétence liée : @VM.AbilityName(_selectedItem.LinkedAbilityId)</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_selectedItem.Description))
            {
                <div class="sts-card-desc">@_selectedItem.Description</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _showActionsModal;
    private bool _histoireExpanded;
    private bool _exporting;
    private int  _activeTab;

    // Collapse — tout ouvert par défaut
    private bool _certOpen   = true;
    private bool _compOpen   = true;
    private bool _r1Open     = true;
    private bool _r2Open     = true;
    private bool _r3Open     = true;
    private bool _traitsOpen = true;

    // Modale item inventaire
    private bool           _showItemModal;
    private CharacterItem? _selectedItem;
    private bool           _itemIsMain;
    private bool           _itemIsOff;
    private bool           _itemUnmastered;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Auth.RequestLogin();
            Nav.NavigateTo("/");
            return;
        }

        VM.OnStateChanged = StateHasChanged;
        await VM.LoadAsync(Id);
    }

    private void ToggleRang(int rang)
    {
        if (rang == 1)      _r1Open = !_r1Open;
        else if (rang == 2) _r2Open = !_r2Open;
        else                _r3Open = !_r3Open;
    }

    private void OpenItemModal(CharacterItem item, bool isMain, bool isOff, bool unmastered)
    {
        _selectedItem   = item;
        _itemIsMain     = isMain;
        _itemIsOff      = isOff;
        _itemUnmastered = unmastered;
        _showItemModal  = true;
    }

    private async Task Delete()
    {
        if (!await JS.InvokeAsync<bool>("confirm",
            $"Supprimer la fiche de « {VM.Character?.Name} » ? Cette action est irréversible."))
            return;

        var error = await VM.DeleteAsync();
        if (error is null) Nav.NavigateTo("/personnages");
    }

    private async Task ExportDiscord()
    {
        _exporting = true; StateHasChanged();
        try
        {
            var (data, _) = await Api.DownloadDiscordExportAsync(Id);
            if (data is not null)
                await JS.InvokeVoidAsync("downloadFile",
                    $"{VM.Character!.Name.Replace(" ", "_")}_discord.zip",
                    "application/zip", data);
        }
        finally { _exporting = false; StateHasChanged(); }
    }

    private async Task ExportPdf()
    {
        _exporting = true; StateHasChanged();
        try
        {
            var (data, _) = await Api.DownloadPdfAsync(Id);
            if (data is not null)
                await JS.InvokeVoidAsync("downloadFile",
                    $"{VM.Character!.Name.Replace(" ", "_")}.pdf",
                    "application/pdf", data);
        }
        finally { _exporting = false; StateHasChanged(); }
    }
}
