    private static string PostAnchor(RulesSection section, RulesPost post) =>
        $"{section.Id}-{post.Id}";

    private string PostCssClass(RulesSection section, RulesPost post) =>
        _activePost == post ? "active" : string.Empty;

    private void SelectPost(RulesSection section, RulesPost post) =>
        _activePost = post;
