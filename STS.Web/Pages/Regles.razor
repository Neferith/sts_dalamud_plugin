    {
        try
        {
            _sections = await Http.GetFromJsonAsync<List<RulesSection>>("api/rules");

            // Sélectionner le premier post par défaut
            _activePost = _sections?
                .OrderBy(s => s.Order)
                .SelectMany(s => s.Posts)
                .FirstOrDefault();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

