@inject AuthService Auth

@if (Visible)
{
    <div class="sts-modal-backdrop" @onclick="HandleBackdropClick"></div>

    <div class="sts-modal" role="dialog" aria-modal="true" aria-labelledby="login-title">
        <div class="sts-modal-header">
            <h2 class="sts-modal-title" id="login-title">Connexion</h2>
            <button class="sts-modal-close" @onclick="Close" aria-label="Fermer">✕</button>
        </div>

        <div class="sts-modal-body">
            @if (_error is not null)
            {
                <div class="sts-alert sts-alert-error">@_error</div>
            }

            <div class="sts-field">
                <label class="sts-label" for="login-username">Nom d'utilisateur</label>
                <input id="login-username"
                       class="sts-input @(_error is not null ? "sts-input-error" : "")"
                       type="text"
                       @bind="_username"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       placeholder="Ton nom de joueur"
                       autocomplete="username"
                       disabled="@_loading" />
            </div>

            <div class="sts-field">
                <label class="sts-label" for="login-password">Code d'accès</label>
                <input id="login-password"
                       class="sts-input @(_error is not null ? "sts-input-error" : "")"
                       type="password"
                       @bind="_password"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       placeholder="Code fourni par l'admin"
                       autocomplete="current-password"
                       disabled="@_loading" />
            </div>
        </div>

        <div class="sts-modal-footer">
            <button class="sts-btn sts-btn-ghost" @onclick="Close" disabled="@_loading">
                Annuler
            </button>
            <button class="sts-btn sts-btn-primary" @onclick="Submit"
                    disabled="@(_loading || !CanSubmit)">
                @if (_loading)
                {
                    <span class="sts-spinner"></span>
                    <span>Connexion…</span>
                }
                else
                {
                    <span>Se connecter</span>
                }
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool    Visible        { get; set; }
    [Parameter] public EventCallback OnClose  { get; set; }

    private string  _username = string.Empty;
    private string  _password = string.Empty;
    private string? _error;
    private bool    _loading;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_username) &&
        !string.IsNullOrWhiteSpace(_password);

    private async Task Submit()
    {
        if (!CanSubmit) return;

        _loading = true;
        _error   = null;

        var error = await Auth.LoginAsync(_username.Trim(), _password);

        _loading = false;

        if (error is not null)
        {
            _error = error;
        }
        else
        {
            _username = string.Empty;
            _password = string.Empty;
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
        if (e.Key == "Escape") await Close();
    }

    private async Task Close()
    {
        _error    = string.Empty;
        _username = string.Empty;
        _password = string.Empty;
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick() => await Close();
}
