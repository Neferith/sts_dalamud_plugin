@if (Message != null)
{
    <div class="alert @(IsError ? "alert-danger" : "alert-success") alert-dismissible d-flex align-items-center mb-3">
        <span class="flex-grow-1">@Message</span>
        <button type="button" class="btn-close ms-2" @onclick="OnDismiss"></button>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool IsError { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
}
