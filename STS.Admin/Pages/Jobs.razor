@page "/jobs"
@using Microsoft.AspNetCore.Components.Forms
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Jobs — STS Admin</PageTitle>

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Jobs</h2>
            <small class="text-muted">@Filtered.Count / @_jobs.Count job(s)</small>
        </div>
        <button class="btn btn-primary" @onclick="OpenCreate">+ Nouveau job</button>
    </div>

    <!-- Filtres -->
    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <input class="form-control" placeholder="🔍 Nom ou identifiant…"
                   @bind="_search" @bind:event="oninput" />
        </div>
        @if (_search.Length > 0)
        {
            <div class="col-auto">
                <button class="btn btn-outline-secondary" @onclick="ResetFilters">✕ Réinitialiser</button>
            </div>
        }
    </div>

    <Alert Message="_message" IsError="_isError" OnDismiss="() => _message = null" />

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-secondary"></div></div>
    }
    else if (Filtered.Count == 0)
    {
        <div class="text-center text-muted py-5">
            @(_jobs.Count == 0 ? "Aucun job. Commencez par en créer un." : "Aucun résultat pour ces filtres.")
        </div>
    }
    else
    {
        <div class="card">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:48px"></th>
                        <th @onclick='() => SetSort("id")' style="cursor:pointer; user-select:none">
                            Identifiant @SortIcon("id")
                        </th>
                        <th @onclick='() => SetSort("name")' style="cursor:pointer; user-select:none">
                            Nom @SortIcon("name")
                        </th>
                        <th style="width:90px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Filtered)
                    {
                        <tr>
                            <td class="align-middle">
                                @if (job.IconUrl is not null)
                                {
                                    <img src="@job.IconUrl"
                                         style="width:32px;height:32px;object-fit:contain;border-radius:4px;"
                                         alt="@job.Name" />
                                }
                                else
                                {
                                    <div style="width:32px;height:32px;border-radius:4px;
                                                background:#f8f9fa;border:1px dashed #dee2e6;"></div>
                                }
                            </td>
                            <td class="align-middle"><code class="text-secondary">@job.Id</code></td>
                            <td class="align-middle fw-medium">@job.Name</td>
                            <td class="text-end align-middle">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            style="width:32px;"
                                            title="Fiche vierge PDF"
                                            disabled="@(_downloading == job.Id)"
                                            @onclick="() => DownloadSheet(job)">
                                        @(_downloading == job.Id ? "…" : "↓")
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" style="width:32px;"
                                            @onclick="() => OpenEdit(job)" title="Modifier">✏</button>
                                    <button class="btn btn-sm btn-outline-danger" style="width:32px;"
                                            @onclick="() => Delete(job)" title="Supprimer">✕</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ── Modal job ─────────────────────────────────────────────────────────── -->
@if (_showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editMode ? "Modifier le job" : "Nouveau job")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Identifiant <small class="text-muted">(unique, sans espaces ni accents)</small></label>
                        <input class="form-control font-monospace" @bind="_form.Id"
                               disabled="@_editMode" placeholder="ex: guerrier" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nom affiché</label>
                        <input class="form-control" @bind="_form.Name" placeholder="ex: Guerrier" />
                    </div>

                    <!-- Icône depuis la galerie -->
                    <!-- Icône -->
                    <div class="mb-3">
                        <label class="form-label">Icône</label>
                        <div class="d-flex align-items-center gap-3">
                            @if (_form.IconUrl is not null)
                            {
                                <img src="@_form.IconUrl"
                                     style="width:52px;height:52px;object-fit:contain;
                                            border-radius:6px;border:1px solid #dee2e6;flex-shrink:0;" />
                            }
                            else
                            {
                                <div style="width:52px;height:52px;border-radius:6px;border:1px dashed #dee2e6;
                                            background:#f8f9fa;display:flex;align-items:center;
                                            justify-content:center;color:#adb5bd;font-size:22px;flex-shrink:0;">?</div>
                            }
                            <div class="d-flex flex-column gap-1 flex-grow-1">
                                <div class="d-flex gap-2 align-items-center">
                                    <InputFile OnChange="UploadIcon" accept=".jpg,.jpeg,.png,.webp"
                                               class="form-control form-control-sm"
                                               disabled="@_uploadingIcon" />
                                    @if (_uploadingIcon)
                                    {
                                        <div class="spinner-border spinner-border-sm text-secondary flex-shrink-0"></div>
                                    }
                                </div>
                                @if (_iconUploadError is not null)
                                {
                                    <small class="text-danger">@_iconUploadError</small>
                                }
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            @onclick="OpenImagePicker">
                                        📂 Galerie
                                    </button>
                                    @if (_form.IconUrl is not null)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                @onclick="() => _form.IconUrl = null">
                                            ✕ Retirer
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                        @(_saving ? "Sauvegarde…" : "Sauvegarder")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Modal sélecteur d'images ──────────────────────────────────────────── -->
@if (_showImagePicker)
{
    <div class="modal-backdrop fade show" style="z-index:1060;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1070;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Choisir une icône</h5>
                    <button type="button" class="btn-close"
                            @onclick="() => _showImagePicker = false"></button>
                </div>
                <div class="modal-body">
                    @if (_loadingImages)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border text-secondary"></div>
                        </div>
                    }
                    else if (_galleryImages.Count == 0)
                    {
                        <p class="text-muted text-center py-3">
                            Aucune image dans la galerie.<br />
                            <small>Uploadez des images via la section Galerie.</small>
                        </p>
                    }
                    else
                    {
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(80px,1fr));gap:8px;">
                            @foreach (var img in _galleryImages)
                            {
                                var imgUrl = img.Url;
                                var isSelected = _form.IconUrl == imgUrl;
                                <div style="cursor:pointer;border:2px solid @(isSelected ? "#0d6efd" : "transparent");
                                            border-radius:6px;padding:4px;transition:border-color .15s;
                                            background:@(isSelected ? "#e7f1ff" : "transparent")"
                                     @onclick="() => SelectImage(imgUrl)"
                                     title="@imgUrl">
                                    <img src="@imgUrl"
                                         style="width:100%;aspect-ratio:1/1;object-fit:contain;" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<JobDto> _jobs      = [];
    private bool         _loading   = true;
    private bool         _showModal;
    private bool         _editMode;
    private bool         _saving;
    private string?      _message;
    private bool         _isError;
    private JobDto       _form      = new();
    private string?      _downloading;

    // Sélecteur galerie
    private bool          _showImagePicker;
    private bool          _loadingImages;
    private List<ImageDto>  _galleryImages = [];

    private bool    _uploadingIcon;
    private string? _iconUploadError;

    // ─── Filtres & tri ────────────────────────────────────────────────────────
    private string _search  = "";
    private string _sortBy  = "name";
    private bool   _sortAsc = true;

    private List<JobDto> Filtered
    {
        get
        {
            var q = _jobs.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim().ToLowerInvariant();
                q = q.Where(j => j.Name.ToLowerInvariant().Contains(s)
                               || j.Id.ToLowerInvariant().Contains(s));
            }
            q = _sortBy switch
            {
                "id" => _sortAsc ? q.OrderBy(j => j.Id)   : q.OrderByDescending(j => j.Id),
                _    => _sortAsc ? q.OrderBy(j => j.Name) : q.OrderByDescending(j => j.Name),
            };
            return q.ToList();
        }
    }

    private void SetSort(string col)
    {
        if (_sortBy == col) _sortAsc = !_sortAsc;
        else { _sortBy = col; _sortAsc = true; }
    }

    private string SortIcon(string col) => _sortBy != col ? " ⇅" : _sortAsc ? " ↑" : " ↓";
    private void ResetFilters() => _search = "";

    // ─── Données ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _jobs    = await Api.GetAsync<List<JobDto>>("/api/jobs") ?? [];
        _loading = false;
    }

    // ─── Export PDF ───────────────────────────────────────────────────────────
    private async Task DownloadSheet(JobDto job)
    {
        _downloading = job.Id;
        try
        {
            var response = await Api.GetRawAsync($"/api/jobs/{job.Id}/export/pdf");
            if (response is null)
            {
                ShowError($"Erreur lors de la génération de la fiche « {job.Name} ».");
                return;
            }
            var safeName = job.Name.Replace(" ", "_");
            await JS.InvokeVoidAsync("downloadFile", $"{safeName}_fiche.pdf", "application/pdf", response);
        }
        finally { _downloading = null; }
    }

    // ─── Sélecteur galerie ────────────────────────────────────────────────────
    private async Task OpenImagePicker()
    {
        _showImagePicker = true;
        _loadingImages   = true;
        _galleryImages   = await Api.GetAsync<List<ImageDto>>("/api/images") ?? [];
        _loadingImages   = false;
    }

    private void SelectImage(string url)
    {
        _form.IconUrl    = url;
        _showImagePicker = false;
    }

    private async Task UploadIcon(InputFileChangeEventArgs e)
    {
        _iconUploadError = null;
        _uploadingIcon   = true;
        try
        {
            var file    = e.File;
            var content = new MultipartFormDataContent();
            var stream  = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", file.Name);

            var (data, error) = await Api.PostFormAsync("/api/images", content);
            if (error is not null)
                _iconUploadError = error;
            else
                _form.IconUrl = data?.GetProperty("url").GetString();
        }
        finally { _uploadingIcon = false; }
    }

    // ─── Modal ────────────────────────────────────────────────────────────────
    private void OpenCreate() { _form = new JobDto(); _editMode = false; _showModal = true; }
    private void OpenEdit(JobDto job) { _form = job.Clone(); _editMode = true; _showModal = true; }
    private void CloseModal() => _showModal = false;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.Id))   { ShowError("L'identifiant est requis."); return; }
        if (string.IsNullOrWhiteSpace(_form.Name)) { ShowError("Le nom est requis."); return; }
        _saving = true;
        try
        {
            string? error;
            if (_editMode) (_, error) = await Api.PutAsync<JobDto>($"/api/jobs/{_form.Id}", _form);
            else           (_, error) = await Api.PostAsync<JobDto>("/api/jobs", _form);
            if (error is not null) ShowError(error);
            else { ShowSuccess(_editMode ? "Job modifié." : "Job créé."); CloseModal(); await Load(); }
        }
        finally { _saving = false; }
    }

    private async Task Delete(JobDto job)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Supprimer le job « {job.Name} » ?")) return;
        var error = await Api.DeleteAsync($"/api/jobs/{job.Id}");
        if (error is not null) ShowError(error);
        else { ShowSuccess("Job supprimé."); await Load(); }
    }

    private void ShowError(string msg)   { _isError = true;  _message = msg; }
    private void ShowSuccess(string msg) { _isError = false; _message = msg; }
}
