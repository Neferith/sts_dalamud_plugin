@page "/traits"
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Traits — STS Admin</PageTitle>

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Traits</h2>
            <small class="text-muted">@_traits.Count trait(s)</small>
        </div>
        <button class="btn btn-primary" @onclick="OpenCreate">+ Nouveau trait</button>
    </div>

    <Alert Message="_message" IsError="_isError" OnDismiss="() => _message = null" />

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-secondary"></div></div>
    }
    else
    {
        <div class="card">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nom</th>
                        <th>Catégorie</th>
                        <th>Jobs requis</th>
                        <th>Effets</th>
                        <th style="width:100px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trait in _traits.OrderBy(t => t.Category).ThenBy(t => t.Name))
                    {
                        <tr>
                            <td>
                                <div class="fw-medium">@trait.Name</div>
                                <small class="text-muted font-monospace">@trait.Id</small>
                            </td>
                            <td><span class="badge bg-secondary">@trait.Category</span></td>
                            <td>
                                @if (trait.RequiredJobIds?.Count > 0)
                                {
                                    @foreach (var jid in trait.RequiredJobIds)
                                    {
                                        <span class="badge bg-light text-dark border me-1 badge-job">@JobName(jid)</span>
                                    }
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td><span class="badge bg-info text-dark">@trait.Effects.Count effet(s)</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEdit(trait)" title="Modifier">✏</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(trait)" title="Supprimer">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editMode ? "Modifier le trait" : "Nouveau trait")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-5">
                            <label class="form-label">Identifiant</label>
                            <input class="form-control font-monospace" @bind="_form.Id" disabled="@_editMode" placeholder="ex: tir_precise" />
                        </div>
                        <div class="col-7">
                            <label class="form-label">Nom</label>
                            <input class="form-control" @bind="_form.Name" placeholder="ex: Tir précis" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="2" @bind="_form.Description" placeholder="Description affichée sur la fiche."></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label">Catégorie</label>
                            <select class="form-select" @bind="_form.Category">
                                @foreach (var cat in StsConstants.TraitCategories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Groupe exclusif <small class="text-muted">(optionnel)</small></label>
                            <input class="form-control font-monospace" @bind="_form.ExclusiveGroup" placeholder="ex: style_combat" />
                        </div>
                    </div>

                    <!-- Jobs requis -->
                    <div class="mb-4">
                        <label class="form-label">Jobs requis <small class="text-muted">(laisser vide = tous)</small></label>
                        <div class="d-flex flex-wrap gap-2 p-2 border rounded">
                            @foreach (var job in _allJobs.OrderBy(j => j.Name))
                            {
                                <div class="form-check form-check-inline m-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="tj_@job.Id"
                                           checked="@(_selectedJobIds.Contains(job.Id))"
                                           @onchange="e => ToggleJob(job.Id, (bool)(e.Value ?? false))" />
                                    <label class="form-check-label" for="tj_@job.Id">@job.Name</label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Effets -->
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label mb-0 fw-medium">Effets mécaniques</label>
                            <button class="btn btn-sm btn-outline-primary" @onclick="AddEffect">+ Ajouter un effet</button>
                        </div>

                        @if (_form.Effects.Count == 0)
                        {
                            <p class="text-muted small mb-0">Aucun effet — le trait est déclaratif (géré par le MJ).</p>
                        }

                        @for (var i = 0; i < _form.Effects.Count; i++)
                        {
                            var idx = i;
                            var effect = _form.Effects[idx];
                            <div class="effect-card">
                                <div class="row g-2 align-items-end">
                                    <div class="col-4">
                                        <label class="form-label small mb-1">Type</label>
                                        <select class="form-select form-select-sm"
                                                value="@effect.Type"
                                                @onchange="e => effect.Type = e.Value?.ToString() ?? effect.Type">
                                            @foreach (var t in StsConstants.TraitEffectTypes)
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-2">
                                        <label class="form-label small mb-1">Valeur</label>
                                        <input type="number" class="form-control form-control-sm" @bind="effect.Value" />
                                    </div>
                                    @if (effect.Type == "ForceRollMode")
                                    {
                                        <div class="col-3">
                                            <label class="form-label small mb-1">Mode forcé</label>
                                            <select class="form-select form-select-sm" @bind="effect.ForcedMode">
                                                <option value="">— aucun —</option>
                                                @foreach (var m in StsConstants.RollModes)
                                                {
                                                    <option value="@m">@m</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                    <div class="col">
                                        <label class="form-label small mb-1">Contexte <small class="text-muted">(optionnel)</small></label>
                                        <input class="form-control form-control-sm" @bind="effect.Context" placeholder="ex: Attaque" />
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveEffect(idx)" title="Retirer">✕</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                        @(_saving ? "Sauvegarde…" : "Sauvegarder")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TraitDto> _traits = [];
    private List<JobDto>   _allJobs = [];
    private HashSet<string> _selectedJobIds = [];

    private bool _loading = true;
    private bool _showModal;
    private bool _editMode;
    private bool _saving;
    private string? _message;
    private bool _isError;
    private TraitDto _form = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await Task.WhenAll(LoadTraits(), LoadJobs());
        _loading = false;
    }

    private async Task LoadTraits() => _traits = await Api.GetAsync<List<TraitDto>>("/api/traits") ?? [];
    private async Task LoadJobs()   => _allJobs = await Api.GetAsync<List<JobDto>>("/api/jobs") ?? [];

    private string JobName(string id) => _allJobs.FirstOrDefault(j => j.Id == id)?.Name ?? id;

    private void ToggleJob(string id, bool selected)
    {
        if (selected) _selectedJobIds.Add(id);
        else _selectedJobIds.Remove(id);
    }

    private void OpenCreate()
    {
        _form           = new TraitDto();
        _selectedJobIds = [];
        _editMode       = false;
        _showModal      = true;
    }

    private void OpenEdit(TraitDto trait)
    {
        _form           = trait.Clone();
        _selectedJobIds = [.. (_form.RequiredJobIds ?? [])];
        _editMode       = true;
        _showModal      = true;
    }

    private void CloseModal() => _showModal = false;

    private void AddEffect()    => _form.Effects.Add(new TraitEffectDto());
    private void RemoveEffect(int i) => _form.Effects.RemoveAt(i);

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.Id))          { ShowError("L'identifiant est requis."); return; }
        if (string.IsNullOrWhiteSpace(_form.Name))        { ShowError("Le nom est requis."); return; }
        if (string.IsNullOrWhiteSpace(_form.Category))    { ShowError("La catégorie est requise."); return; }
        if (string.IsNullOrWhiteSpace(_form.Description)) { ShowError("La description est requise."); return; }

        // Appliquer la sélection des jobs
        _form.RequiredJobIds = _selectedJobIds.Count > 0 ? [.. _selectedJobIds] : null;

        // Nettoyer ForcedMode si le type n'est pas ForceRollMode
        foreach (var e in _form.Effects.Where(e => e.Type != "ForceRollMode"))
            e.ForcedMode = null;

        _saving = true;
        try
        {
            string? error;
            if (_editMode)
                (_, error) = await Api.PutAsync<TraitDto>($"/api/traits/{_form.Id}", _form);
            else
                (_, error) = await Api.PostAsync<TraitDto>("/api/traits", _form);

            ShowResult(error, _editMode ? "Trait modifié." : "Trait créé.");
            if (error is null) { CloseModal(); await LoadTraits(); }
        }
        finally { _saving = false; }
    }

    private async Task Delete(TraitDto trait)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Supprimer le trait « {trait.Name} » ?")) return;
        var error = await Api.DeleteAsync($"/api/traits/{trait.Id}");
        ShowResult(error, "Trait supprimé.");
        if (error is null) await LoadTraits();
    }

    private void ShowResult(string? error, string successMsg)
    {
        _isError = error is not null;
        _message = error ?? successMsg;
    }

      private void ShowError(string msg)
    {
        _isError = true;
        _message = msg;
    }
}
