@page "/rules"
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Règles — STS Admin</PageTitle>

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Règles</h2>
        <button class="btn btn-primary" @onclick="OpenCreateSection">+ Nouvelle section</button>
    </div>

    <Alert Message="_message" IsError="_isError" OnDismiss="() => _message = null" />

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-secondary"></div></div>
    }
    else
    {
        <div class="row g-3">

            <!-- ── Colonne sections ─────────────────────────────────────────── -->
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header table-dark text-white fw-medium">
                        Sections <span class="badge bg-secondary ms-1">@_sections.Count</span>
                    </div>
                    @if (_sections.Count == 0)
                    {
                        <div class="card-body text-center text-muted py-4">
                            Aucune section. Créez-en une.
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var sec in _sections)
                            {
                                var isSelected = _selectedSection?.Id == sec.Id;
                                <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isSelected ? "active" : "")"
                                    style="cursor:pointer"
                                    @onclick="() => SelectSection(sec)">
                                    <div>
                                        <div class="fw-medium">@sec.Title</div>
                                        <small class="@(isSelected ? "text-white-50" : "text-muted") font-monospace">
                                            #@sec.Order — @sec.Id
                                        </small>
                                    </div>
                                    <div class="d-flex gap-1 ms-2" @onclick:stopPropagation>
                                        <button class="btn btn-sm @(isSelected ? "btn-outline-light" : "btn-outline-secondary")"
                                                @onclick="() => OpenEditSection(sec)" title="Modifier">✏</button>
                                        <button class="btn btn-sm @(isSelected ? "btn-outline-light" : "btn-outline-danger")"
                                                @onclick="() => DeleteSection(sec)" title="Supprimer">✕</button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <!-- ── Colonne posts ────────────────────────────────────────────── -->
            <div class="col-md-8">
                @if (_selectedSection is null)
                {
                    <div class="text-center text-muted py-5">
                        Sélectionnez une section pour gérer ses articles.
                    </div>
                }
                else
                {
                    <div class="card">
                        <div class="card-header table-dark text-white d-flex justify-content-between align-items-center">
                            <span>
                                Articles — <strong>@_selectedSection.Title</strong>
                                <span class="badge bg-secondary ms-1">@_selectedSection.Posts.Count</span>
                            </span>
                            <button class="btn btn-sm btn-outline-light" @onclick="OpenCreatePost">
                                + Nouvel article
                            </button>
                        </div>
                        @if (_selectedSection.Posts.Count == 0)
                        {
                            <div class="card-body text-center text-muted py-4">
                                Aucun article dans cette section.
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Titre</th>
                                        <th>Identifiant</th>
                                        <th style="width:100px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var post in _selectedSection.Posts)
                                    {
                                        <tr>
                                            <td class="fw-medium">@post.Title</td>
                                            <td><small class="text-muted font-monospace">@post.Id</small></td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-secondary me-1"
                                                        @onclick="() => OpenEditPost(post)" title="Modifier">✏</button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => DeletePost(post)" title="Supprimer">✕</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                }
            </div>

        </div>
    }
</div>

<!-- ── Modal section ──────────────────────────────────────────────────────── -->
@if (_showSectionModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(_sectionEditMode ? "Modifier la section" : "Nouvelle section")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseSectionModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Identifiant</label>
                        <input class="form-control font-monospace"
                               @bind="_sectionForm.Id"
                               disabled="@_sectionEditMode"
                               placeholder="ex: guide-systeme" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Titre</label>
                        <input class="form-control"
                               @bind="_sectionForm.Title"
                               placeholder="ex: Guide du système" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ordre d'affichage</label>
                        <input type="number" class="form-control"
                               @bind="_sectionForm.Order"
                               min="0" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseSectionModal">Annuler</button>
                    <button class="btn btn-primary" @onclick="SaveSection" disabled="@_saving">
                        @(_saving ? "Sauvegarde…" : "Sauvegarder")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Modal post ─────────────────────────────────────────────────────────── -->
@if (_showPostModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(_postEditMode ? "Modifier l'article" : "Nouvel article")
                    </h5>
                    <button type="button" class="btn-close" @onclick="ClosePostModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Identifiant</label>
                        <input class="form-control font-monospace"
                               @bind="_postForm.Id"
                               disabled="@_postEditMode"
                               placeholder="ex: systeme-tres-simple" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Titre</label>
                        <input class="form-control"
                               @bind="_postForm.Title"
                               placeholder="ex: Le Système Très Simple" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Contenu
                            <small class="text-muted ms-1">Markdown</small>
                        </label>
                        <textarea class="form-control font-monospace"
                                  rows="14"
                                  @bind="_postForm.Content"
                                  placeholder="# Titre&#10;&#10;Contenu en Markdown…"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePostModal">Annuler</button>
                    <button class="btn btn-primary" @onclick="SavePost" disabled="@_saving">
                        @(_saving ? "Sauvegarde…" : "Sauvegarder")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {

    // ── État ──────────────────────────────────────────────────────────────────

    private List<RulesSectionDto> _sections        = [];
    private RulesSectionDto?      _selectedSection;

    private bool    _loading = true;
    private bool    _saving;
    private string? _message;
    private bool    _isError;

    // ── Modal section ─────────────────────────────────────────────────────────

    private bool            _showSectionModal;
    private bool            _sectionEditMode;
    private RulesSectionDto _sectionForm = new();

    // ── Modal post ────────────────────────────────────────────────────────────

    private bool         _showPostModal;
    private bool         _postEditMode;
    private RulesPostDto _postForm = new();

    // ── Init ──────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await LoadSections();
        _loading = false;
    }

    private async Task LoadSections()
    {
        _sections = await Api.GetAsync<List<RulesSectionDto>>("/api/rules") ?? [];

        // Resynchronise la section sélectionnée après rechargement
        if (_selectedSection is not null)
            _selectedSection = _sections.FirstOrDefault(s => s.Id == _selectedSection.Id);
    }

    private void SelectSection(RulesSectionDto sec) => _selectedSection = sec;

    // ── Sections — modal ──────────────────────────────────────────────────────

    private void OpenCreateSection()
    {
        _sectionForm     = new RulesSectionDto { Order = _sections.Count > 0 ? _sections[^1].Order + 1 : 0 };
        _sectionEditMode = false;
        _showSectionModal = true;
    }

    private void OpenEditSection(RulesSectionDto sec)
    {
        _sectionForm      = sec.Clone();
        _sectionEditMode  = true;
        _showSectionModal = true;
    }

    private void CloseSectionModal() => _showSectionModal = false;

    private async Task SaveSection()
    {
        if (string.IsNullOrWhiteSpace(_sectionForm.Id))    { ShowError("L'identifiant est requis."); return; }
        if (string.IsNullOrWhiteSpace(_sectionForm.Title)) { ShowError("Le titre est requis.");      return; }

        _saving = true;
        try
        {
            string? error;
            if (_sectionEditMode)
            {
                (_, error) = await Api.PutAsync<RulesSectionDto>(
                    $"/api/rules/sections/{_sectionForm.Id}",
                    new { _sectionForm.Title, _sectionForm.Order });
            }
            else
            {
                (_, error) = await Api.PostAsync<RulesSectionDto>(
                    "/api/rules/sections",
                    new { _sectionForm.Id, _sectionForm.Title, _sectionForm.Order });
            }

            if (error is not null) ShowError(error);
            else
            {
                ShowSuccess(_sectionEditMode ? "Section modifiée." : "Section créée.");
                CloseSectionModal();
                await LoadSections();
            }
        }
        finally { _saving = false; }
    }

    private async Task DeleteSection(RulesSectionDto sec)
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                $"Supprimer la section « {sec.Title} » et tous ses articles ?")) return;

        var error = await Api.DeleteAsync($"/api/rules/sections/{sec.Id}");
        if (error is not null) ShowError(error);
        else
        {
            if (_selectedSection?.Id == sec.Id) _selectedSection = null;
            ShowSuccess("Section supprimée.");
            await LoadSections();
        }
    }

    // ── Posts — modal ─────────────────────────────────────────────────────────

    private void OpenCreatePost()
    {
        _postForm      = new RulesPostDto();
        _postEditMode  = false;
        _showPostModal = true;
    }

    private void OpenEditPost(RulesPostDto post)
    {
        _postForm      = post.Clone();
        _postEditMode  = true;
        _showPostModal = true;
    }

    private void ClosePostModal() => _showPostModal = false;

    private async Task SavePost()
    {
        if (_selectedSection is null) return;
        if (string.IsNullOrWhiteSpace(_postForm.Id))      { ShowError("L'identifiant est requis."); return; }
        if (string.IsNullOrWhiteSpace(_postForm.Title))   { ShowError("Le titre est requis.");      return; }
        if (string.IsNullOrWhiteSpace(_postForm.Content)) { ShowError("Le contenu est requis.");    return; }

        _saving = true;
        try
        {
            string? error;
            var sectionId = _selectedSection.Id;

            if (_postEditMode)
            {
                (_, error) = await Api.PutAsync<RulesPostDto>(
                    $"/api/rules/sections/{sectionId}/posts/{_postForm.Id}",
                    new { _postForm.Title, _postForm.Content });
            }
            else
            {
                (_, error) = await Api.PostAsync<RulesPostDto>(
                    $"/api/rules/sections/{sectionId}/posts",
                    new { _postForm.Id, _postForm.Title, _postForm.Content });
            }

            if (error is not null) ShowError(error);
            else
            {
                ShowSuccess(_postEditMode ? "Article modifié." : "Article créé.");
                ClosePostModal();
                await LoadSections();
            }
        }
        finally { _saving = false; }
    }

    private async Task DeletePost(RulesPostDto post)
    {
        if (_selectedSection is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Supprimer l'article « {post.Title} » ?")) return;

        var error = await Api.DeleteAsync(
            $"/api/rules/sections/{_selectedSection.Id}/posts/{post.Id}");

        if (error is not null) ShowError(error);
        else { ShowSuccess("Article supprimé."); await LoadSections(); }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private void ShowError(string msg)   { _isError = true;  _message = msg; }
    private void ShowSuccess(string msg) { _isError = false; _message = msg; }
}
