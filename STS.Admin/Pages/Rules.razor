@page "/rules"
@using Markdig
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Règles — STS Admin</PageTitle>

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Règles</h2>
        <button class="btn btn-primary" @onclick="OpenCreateSection">+ Nouvelle section</button>
    </div>

    <Alert Message="_message" IsError="_isError" OnDismiss="() => _message = null" />

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-secondary"></div></div>
    }
    else
    {
        <div class="row g-3">

            <!-- ── Colonne sections ─────────────────────────────────────────── -->
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header table-dark text-white fw-medium">
                        Sections <span class="badge bg-secondary ms-1">@_sections.Count</span>
                    </div>
                    @if (_sections.Count == 0)
                    {
                        <div class="card-body text-center text-muted py-4">
                            Aucune section. Créez-en une.
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var sec in _sections)
                            {
                                var isSelected = _selectedSection?.Id == sec.Id;
                                <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isSelected ? "active" : "")"
                                    style="cursor:pointer"
                                    @onclick="() => SelectSection(sec)">
                                    <div>
                                        <div class="fw-medium">@sec.Title</div>
                                        <small class="@(isSelected ? "text-white-50" : "text-muted") font-monospace">
                                            #@sec.Order — @sec.Id
                                        </small>
                                    </div>
                                    <div class="d-flex gap-1 ms-2" @onclick:stopPropagation>
                                        <button class="btn btn-sm @(isSelected ? "btn-outline-light" : "btn-outline-secondary")"
                                                @onclick="() => OpenEditSection(sec)" title="Modifier">✏</button>
                                        <button class="btn btn-sm @(isSelected ? "btn-outline-light" : "btn-outline-danger")"
                                                @onclick="() => DeleteSection(sec)" title="Supprimer">✕</button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <!-- ── Colonne posts ────────────────────────────────────────────── -->
            <div class="col-md-8">
                @if (_selectedSection is null)
                {
                    <div class="text-center text-muted py-5">
                        Sélectionnez une section pour gérer ses articles.
                    </div>
                }
                else
                {
                    <div class="card">
                        <div class="card-header table-dark text-white d-flex justify-content-between align-items-center">
                            <span>
                                Articles — <strong>@_selectedSection.Title</strong>
                                <span class="badge bg-secondary ms-1">@_selectedSection.Posts.Count</span>
                            </span>
                            <button class="btn btn-sm btn-outline-light" @onclick="OpenCreatePost">
                                + Nouvel article
                            </button>
                        </div>
                        @if (_selectedSection.Posts.Count == 0)
                        {
                            <div class="card-body text-center text-muted py-4">
                                Aucun article dans cette section.
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Titre</th>
                                        <th>Identifiant</th>
                                        <th style="width:100px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var post in _selectedSection.Posts)
                                    {
                                        <tr>
                                            <td class="fw-medium">@post.Title</td>
                                            <td><small class="text-muted font-monospace">@post.Id</small></td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-secondary me-1"
                                                        @onclick="() => OpenEditPost(post)" title="Modifier">✏</button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => DeletePost(post)" title="Supprimer">✕</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                }
            </div>

        </div>
    }
</div>

<!-- ── Modal section ──────────────────────────────────────────────────────── -->
@if (_showSectionModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(_sectionEditMode ? "Modifier la section" : "Nouvelle section")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseSectionModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Identifiant</label>
                        <input class="form-control font-monospace"
                               @bind="_sectionForm.Id"
                               disabled="@_sectionEditMode"
                               placeholder="ex: guide-systeme" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Titre</label>
                        <input class="form-control"
                               @bind="_sectionForm.Title"
                               placeholder="ex: Guide du système" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ordre d'affichage</label>
                        <input type="number" class="form-control"
                               @bind="_sectionForm.Order"
                               min="0" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseSectionModal">Annuler</button>
                    <button class="btn btn-primary" @onclick="SaveSection" disabled="@_saving">
                        @(_saving ? "Sauvegarde…" : "Sauvegarder")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Modal post ─────────────────────────────────────────────────────────── -->
@if (_showPostModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(_postEditMode ? "Modifier l'article" : "Nouvel article")
                    </h5>
                    <button type="button" class="btn-close" @onclick="ClosePostModal"></button>
                </div>

                <div class="modal-body">

                    <!-- ── Métadonnées ──────────────────────────────────────── -->
                    <div class="mb-3">
                        <label class="form-label">
                            Image
                            <small class="text-muted ms-1">L'URL est copiée automatiquement dans le presse-papier</small>
                        </label>
                        <div class="d-flex align-items-center gap-2">
                            <InputFile OnChange="UploadImage"
                                       accept=".jpg,.jpeg,.png,.gif,.webp"
                                       class="form-control"
                                       disabled="@_uploadingImage" />
                            @if (_uploadingImage)
                            {
                                <div class="spinner-border spinner-border-sm text-secondary flex-shrink-0"></div>
                            }
                        </div>
                        @if (_uploadError is not null)
                        {
                            <div class="text-danger small mt-1">@_uploadError</div>
                        }
                        @if (_uploadedUrl is not null)
                        {
                            <div class="text-success small mt-1">
                                ✓ Tag Markdown copié — <code>![Description](@_uploadedUrl)</code>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Identifiant</label>
                        <input class="form-control font-monospace"
                               @bind="_postForm.Id"
                               disabled="@_postEditMode"
                               placeholder="ex: systeme-tres-simple" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Titre</label>
                        <input class="form-control"
                               @bind="_postForm.Title"
                               placeholder="ex: Le Système Très Simple" />
                    </div>

                    <!-- ── Onglets éditeur / aperçu ─────────────────────────── -->
                    <div class="mb-2 d-flex justify-content-between align-items-center">
                        <label class="form-label mb-0">
                            Contenu <small class="text-muted">Markdown</small>
                            <span class="badge bg-secondary ms-1">@_blocks.Count bloc@(_blocks.Count > 1 ? "s" : "")</span>
                        </label>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button"
                                    class="btn @(_showPreview ? "btn-outline-secondary" : "btn-secondary")"
                                    @onclick="() => _showPreview = false">
                                ✏ Édition
                            </button>
                            <button type="button"
                                    class="btn @(_showPreview ? "btn-secondary" : "btn-outline-secondary")"
                                    @onclick="() => _showPreview = true">
                                👁 Aperçu
                            </button>
                        </div>
                    </div>

                    @if (!_showPreview)
                    {
                        <!-- ── Blocs éditeur ────────────────────────────────── -->
                        @for (var i = 0; i < _blocks.Count; i++)
                        {
                            var index = i;
                            var charCount = _blocks[index].Length;
                            var isOver = charCount > MaxBlockLength;

                            <div class="border rounded mb-2 @(isOver ? "border-danger" : "border-secondary")">
                                <!-- En-tête du bloc -->
                                <div class="d-flex justify-content-between align-items-center px-2 py-1
                                            bg-light border-bottom @(isOver ? "border-danger" : "")">
                                    <small class="text-muted fw-medium">Bloc @(index + 1)</small>
                                    <div class="d-flex align-items-center gap-2">
                                        <small class="@(isOver ? "text-danger fw-bold" : "text-muted")">
                                            @charCount / @MaxBlockLength
                                        </small>
                                        @if (_blocks.Count > 1)
                                        {
                                            <button class="btn btn-sm btn-outline-danger py-0 px-1"
                                                    @onclick="() => RemoveBlock(index)"
                                                    title="Supprimer ce bloc">✕</button>
                                        }
                                    </div>
                                </div>
                                <!-- Textarea -->
                                <textarea class="form-control font-monospace border-0 rounded-0 rounded-bottom"
                                          rows="8"
                                          @bind="_blocks[index]"
                                          @bind:event="oninput"
                                          placeholder="@(index == 0 ? "# Titre\n\nContenu en Markdown…" : "Suite du contenu…")">
                                </textarea>
                            </div>
                        }

                        <button class="btn btn-outline-secondary btn-sm w-100 mt-1"
                                @onclick="AddBlock">
                            + Bloc
                        </button>
                    }
                    else
                    {
                        <!-- ── Aperçu ────────────────────────────────────────── -->
                        <div class="border rounded p-3 rules-preview" style="min-height: 22rem; overflow-y: auto;">
                            @for (var i = 0; i < _blocks.Count; i++)
                            {
                                var index = i;
                                @RenderMarkdown(_blocks[index])
                                @if (index < _blocks.Count - 1)
                                {
                                    <hr class="border-2 border-secondary opacity-50 my-3" />
                                }
                            }
                        </div>
                    }

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePostModal">Annuler</button>
                    <button class="btn btn-primary" @onclick="SavePost" disabled="@_saving">
                        @(_saving ? "Sauvegarde…" : "Sauvegarder")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {

    private const int MaxBlockLength = 2000;
    private const string SplitMarker = "---split---";

    // ── État ──────────────────────────────────────────────────────────────────

    private List<RulesSectionDto> _sections        = [];
    private RulesSectionDto?      _selectedSection;

    private bool    _loading = true;
    private bool    _saving;
    private string? _message;
    private bool    _isError;

    // ── Modal section ─────────────────────────────────────────────────────────

    private bool            _showSectionModal;
    private bool            _sectionEditMode;
    private RulesSectionDto _sectionForm = new();

    // ── Modal post ────────────────────────────────────────────────────────────

    private bool         _showPostModal;
    private bool         _postEditMode;
    private RulesPostDto _postForm  = new();
    private List<string> _blocks    = [""];
    private bool         _showPreview;

    // ── Upload image ──────────────────────────────────────────────────────────

    private bool    _uploadingImage;
    private string? _uploadError;
    private string? _uploadedUrl;

    // ── Init ──────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await LoadSections();
        _loading = false;
    }

    private async Task LoadSections()
    {
        _sections = await Api.GetAsync<List<RulesSectionDto>>("/api/rules") ?? [];

        if (_selectedSection is not null)
            _selectedSection = _sections.FirstOrDefault(s => s.Id == _selectedSection.Id);
    }

    private void SelectSection(RulesSectionDto sec) => _selectedSection = sec;

    // ── Sections — modal ──────────────────────────────────────────────────────

    private void OpenCreateSection()
    {
        _sectionForm      = new RulesSectionDto { Order = _sections.Count > 0 ? _sections[^1].Order + 1 : 0 };
        _sectionEditMode  = false;
        _showSectionModal = true;
    }

    private void OpenEditSection(RulesSectionDto sec)
    {
        _sectionForm      = sec.Clone();
        _sectionEditMode  = true;
        _showSectionModal = true;
    }

    private void CloseSectionModal() => _showSectionModal = false;

    private async Task SaveSection()
    {
        if (string.IsNullOrWhiteSpace(_sectionForm.Id))    { ShowError("L'identifiant est requis."); return; }
        if (string.IsNullOrWhiteSpace(_sectionForm.Title)) { ShowError("Le titre est requis.");      return; }

        _saving = true;
        try
        {
            string? error;
            if (_sectionEditMode)
            {
                (_, error) = await Api.PutAsync<RulesSectionDto>(
                    $"/api/rules/sections/{_sectionForm.Id}",
                    new { _sectionForm.Title, _sectionForm.Order });
            }
            else
            {
                (_, error) = await Api.PostAsync<RulesSectionDto>(
                    "/api/rules/sections",
                    new { _sectionForm.Id, _sectionForm.Title, _sectionForm.Order });
            }

            if (error is not null) ShowError(error);
            else
            {
                ShowSuccess(_sectionEditMode ? "Section modifiée." : "Section créée.");
                CloseSectionModal();
                await LoadSections();
            }
        }
        finally { _saving = false; }
    }

    private async Task DeleteSection(RulesSectionDto sec)
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                $"Supprimer la section « {sec.Title} » et tous ses articles ?")) return;

        var error = await Api.DeleteAsync($"/api/rules/sections/{sec.Id}");
        if (error is not null) ShowError(error);
        else
        {
            if (_selectedSection?.Id == sec.Id) _selectedSection = null;
            ShowSuccess("Section supprimée.");
            await LoadSections();
        }
    }

    // ── Posts — modal ─────────────────────────────────────────────────────────

    private void OpenCreatePost()
    {
        _postForm      = new RulesPostDto();
        _blocks        = [""];
        _showPreview   = false;
        _postEditMode  = false;
        _showPostModal = true;
    }

    private void OpenEditPost(RulesPostDto post)
    {
        _postForm      = post.Clone();
        _blocks        = SplitContent(post.Content);
        _showPreview   = false;
        _postEditMode  = true;
        _showPostModal = true;
    }

    private void ClosePostModal() => _showPostModal = false;

    private async Task SavePost()
    {
        if (_selectedSection is null) return;
        if (string.IsNullOrWhiteSpace(_postForm.Id))    { ShowError("L'identifiant est requis."); return; }
        if (string.IsNullOrWhiteSpace(_postForm.Title)) { ShowError("Le titre est requis.");      return; }
        if (_blocks.All(string.IsNullOrWhiteSpace))     { ShowError("Le contenu est requis.");    return; }

        var overLimit = _blocks.Select((b, i) => (b, i)).Where(x => x.b.Length > MaxBlockLength).ToList();
        if (overLimit.Count > 0)
        {
            var nums = string.Join(", ", overLimit.Select(x => x.i + 1));
            ShowError($"Bloc{(overLimit.Count > 1 ? "s" : "")} {nums} dépasse{(overLimit.Count > 1 ? "nt" : "")} {MaxBlockLength} caractères.");
            return;
        }

        _saving = true;
        try
        {
            var content   = JoinBlocks(_blocks);
            var sectionId = _selectedSection.Id;
            string? error;

            if (_postEditMode)
            {
                (_, error) = await Api.PutAsync<RulesPostDto>(
                    $"/api/rules/sections/{sectionId}/posts/{_postForm.Id}",
                    new { _postForm.Title, Content = content });
            }
            else
            {
                (_, error) = await Api.PostAsync<RulesPostDto>(
                    $"/api/rules/sections/{sectionId}/posts",
                    new { _postForm.Id, _postForm.Title, Content = content });
            }

            if (error is not null) ShowError(error);
            else
            {
                ShowSuccess(_postEditMode ? "Article modifié." : "Article créé.");
                ClosePostModal();
                await LoadSections();
            }
        }
        finally { _saving = false; }
    }

    private async Task DeletePost(RulesPostDto post)
    {
        if (_selectedSection is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Supprimer l'article « {post.Title} » ?")) return;

        var error = await Api.DeleteAsync(
            $"/api/rules/sections/{_selectedSection.Id}/posts/{post.Id}");

        if (error is not null) ShowError(error);
        else { ShowSuccess("Article supprimé."); await LoadSections(); }
    }

    // ── Blocs ─────────────────────────────────────────────────────────────────

    private void AddBlock()    => _blocks.Add("");
    private void RemoveBlock(int index) => _blocks.RemoveAt(index);

    private static List<string> SplitContent(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return [""];
        var blocks = content
            .Split(SplitMarker, StringSplitOptions.None)
            .Select(b => b.Trim('\n', '\r'))
            .ToList();
        return blocks.Count > 0 ? blocks : [""];
    }

    private static string JoinBlocks(List<string> blocks)
        => string.Join($"\n{SplitMarker}\n", blocks.Where(b => !string.IsNullOrWhiteSpace(b)));

    // ── Aperçu ────────────────────────────────────────────────────────────────

    private MarkupString RenderMarkdown(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return (MarkupString)"<p class=\"text-muted fst-italic\">Aucun contenu.</p>";

        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        return (MarkupString)Markdown.ToHtml(content, pipeline);
    }

    // ── Upload image ──────────────────────────────────────────────────────────

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        _uploadError    = null;
        _uploadedUrl    = null;
        _uploadingImage = true;

        try
        {
            var file    = e.File;
            var content = new MultipartFormDataContent();
            var stream  = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", file.Name);

            var (data, error) = await Api.PostFormAsync("/api/images", content);

            if (error is not null)
                _uploadError = error;
            else
            {
                _uploadedUrl = data?.GetProperty("url").GetString();
                if (_uploadedUrl is not null)
                {
                    var markdown = $"![Description]({_uploadedUrl})";
                    await JS.InvokeVoidAsync("navigator.clipboard.writeText", markdown);
                }
            }
        }
        finally { _uploadingImage = false; }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private void ShowError(string msg)   { _isError = true;  _message = msg; }
    private void ShowSuccess(string msg) { _isError = false; _message = msg; }
}
