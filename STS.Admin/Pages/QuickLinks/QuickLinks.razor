@page "/quick-links"
@using Sts.Domain.Content
@using Sts.Domain.Content.Models
@using STS.Admin.ViewModels
@inject QuickLinksViewModel ViewModel
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Liens rapides — STS Admin</PageTitle>

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Liens rapides</h2>
            <small class="text-muted">@ViewModel.Items.Count lien(s)</small>
        </div>
        <button class="btn btn-primary" @onclick="ViewModel.OpenCreate">+ Nouveau lien</button>
    </div>

    <Alert Message="@ViewModel.Error" IsError="true" OnDismiss="() => {}" />

    @if (ViewModel.IsLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-secondary"></div></div>
    }
    else if (ViewModel.Items.Count == 0)
    {
        <div class="text-center text-muted py-5">Aucun lien rapide. Créez-en un.</div>
    }
    else
    {
        <div class="card">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Icône</th>
                        <th>Label</th>
                        <th>URL</th>
                        <th>Catégorie</th>
                        <th>Ordre</th>
                        <th>Visible</th>
                        <th style="width:100px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var link in ViewModel.Items)
                    {
                        <tr>
                            <td style="font-size:1.2rem">@(link.Icon ?? "—")</td>
                            <td class="fw-medium">@link.Label</td>
                            <td><small class="text-muted font-monospace">@link.Url</small></td>
                            <td><span class="badge bg-secondary">@link.Category</span></td>
                            <td>@link.Order</td>
                            <td>
                                @if (link.IsVisible)
                                {
                                    <span class="badge bg-success">Oui</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Non</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => ViewModel.OpenEdit(link)" title="Modifier">✏</button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ConfirmDelete(link)" title="Supprimer">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (ViewModel.IsPanelOpen)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(ViewModel.Editing is null ? "Nouveau lien rapide" : "Modifier le lien")
                    </h5>
                    <button type="button" class="btn-close" @onclick="ViewModel.ClosePanel"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-8">
                            <label class="form-label">Label</label>
                            <input class="form-control" placeholder="ex: Discord"
                                   @bind="ViewModel.FormLabel" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">Icône <small class="text-muted">(emoji ou slug)</small></label>
                            <input class="form-control" placeholder="💬"
                                   @bind="ViewModel.FormIcon" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">URL</label>
                        <input class="form-control font-monospace" placeholder="https://…"
                               @bind="ViewModel.FormUrl" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label">Catégorie</label>
                            <select class="form-select" @bind="ViewModel.FormCategory">
                                @foreach (var cat in Enum.GetValues<QuickLinkCategory>())
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label">Ordre</label>
                            <input type="number" class="form-control" min="0"
                                   @bind="ViewModel.FormOrder" />
                        </div>
                        <div class="col-3 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="chkVisible"
                                       @bind="ViewModel.FormIsVisible" />
                                <label class="form-check-label" for="chkVisible">Visible</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ViewModel.ClosePanel">Annuler</button>
                    <button class="btn btn-primary" @onclick="ViewModel.SaveAsync"
                            disabled="@ViewModel.IsSaving">
                        @(ViewModel.IsSaving ? "Sauvegarde…" : "Sauvegarder")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        ViewModel.OnStateChanged = StateHasChanged;
        await ViewModel.LoadAsync();
    }

    private async Task ConfirmDelete(QuickLink link)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Supprimer le lien « {link.Label} » ?")) return;
        await ViewModel.DeleteAsync(link.Id);
    }
}
