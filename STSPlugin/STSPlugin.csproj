<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/14.0.2">
    <PropertyGroup>
        <PackageProjectUrl>https://github.com/Neferith/sts_dalamud_plugin</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\STS.Domain\STS.Domain.csproj" />
        <Content Include="data.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="MoonLogo_sharpened.png" />
    </ItemGroup>

    <!-- Met à jour AssemblyVersion dans repo.json à chaque build Release -->
    <Target Name="UpdateRepoJson" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <Exec Command="powershell -Command &quot;$f='$(MSBuildProjectDirectory)\..\repo.json'; $j=Get-Content $f | ConvertFrom-Json; $j[0].AssemblyVersion='$(Version)'; $j | ConvertTo-Json -Depth 10 | Set-Content $f -Encoding UTF8&quot;" />
    </Target>
</Project>