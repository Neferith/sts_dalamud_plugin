<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <PackageProjectUrl>https://github.com/Neferith/sts_dalamud_plugin</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\STS.Domain\STS.Domain.csproj" />
        <ProjectReference Include="..\STS.Domain.Character\STS.Domain.Character.csproj" />
        <Content Include="data.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="MoonLogo_sharpened.png" />
    </ItemGroup>

    <!-- Met à jour AssemblyVersion dans repo.json à chaque build Release -->
    <Target Name="UpdateRepoJson" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <Exec Command="powershell -Command &quot;$f='$(MSBuildProjectDirectory)\..\repo.json'; $j=Get-Content $f -Raw -Encoding UTF8 | ConvertFrom-Json; $j[0].AssemblyVersion='$(Version)'; $json=ConvertTo-Json @($j) -Depth 10; [System.IO.File]::WriteAllText($f, $json, [System.Text.UTF8Encoding]::new($false))&quot;" />
    </Target>
</Project>